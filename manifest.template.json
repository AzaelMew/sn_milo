{
  "manifest_version": 3,
  "name": "ServiceNow Milo",
  "version": "1.11.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "111",
  "description": "Combined ServiceNow tools with per-feature toggles: critical/interaction alerts, Informatica button, KB dark mode and timecard overlay.",
  "permissions": [
    "alarms",
    "notifications",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "{{PRODUCTION_ORIGIN}}/*",
    "{{TEST_ORIGIN}}/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ServiceNow Milo options"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
